<Project Sdk="Microsoft.NET.Sdk">
  <!-- The AudioSwitcher.AudioApi stand-in (dotnet/shims/AudioSwitcher.AudioApi), for the .NET 10 host when
       Mono is not here to build and run it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>AudioSwitcher.AudioApi</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <OutputPath>$(LinuxOut)/shims/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../shims/AudioSwitcher.AudioApi/*.cs" />
  </ItemGroup>
</Project>
