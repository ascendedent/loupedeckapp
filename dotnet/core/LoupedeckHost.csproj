<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runs one .NET 8/10 plugin: `dotnet LoupedeckHost.dll Plugin.dll`.
       RollForward lets it run on whatever newer runtime is installed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../LoupedeckHost/*.cs" />
    <ProjectReference Include="PluginApi.csproj" />
    <!-- Shipped beside plugins by the Loupedeck software; see SHARED in build.py. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
