<Project Sdk="Microsoft.NET.Sdk">
  <!-- The same PluginApi sources as the Mono build (../PluginApi), for
       plugins built for .NET 8 and 10. Drawing is SkiaSharp here. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>PluginApi</AssemblyName>
    <RootNamespace>Loupedeck</RootNamespace>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <NoWarn>CS0618;CS0067;CS0108;CS0114;CS0649</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../PluginApi/*.cs" />
    <PackageReference Include="SkiaSharp" Version="2.88.9" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="2.88.9" />
  </ItemGroup>
</Project>
