<Project Sdk="Microsoft.NET.Sdk">
  <!-- The LoupedeckShared stand-in (dotnet/shims/LoupedeckShared), for the .NET 10 host when
       Mono is not here to build and run it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>LoupedeckShared</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <OutputPath>$(LinuxOut)/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../shims/LoupedeckShared/*.cs" />
  </ItemGroup>
</Project>
