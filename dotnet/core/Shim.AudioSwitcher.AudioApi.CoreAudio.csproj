<Project Sdk="Microsoft.NET.Sdk">
  <!-- The AudioSwitcher.AudioApi.CoreAudio stand-in (dotnet/shims/AudioSwitcher.AudioApi.CoreAudio), for the .NET 10 host when
       Mono is not here to build and run it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>AudioSwitcher.AudioApi.CoreAudio</AssemblyName>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <OutputPath>$(LinuxOut)/shims/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../shims/AudioSwitcher.AudioApi.CoreAudio/*.cs" />
    <ProjectReference Include="PluginApi.csproj" Private="false" />
    <ProjectReference Include="Shim.AudioSwitcher.AudioApi.csproj" Private="false" />
  </ItemGroup>
</Project>
