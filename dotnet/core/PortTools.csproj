<Project Sdk="Microsoft.NET.Sdk">
  <!-- ApiScan, PortScan and PortPatch for machines without Mono, which is
       where the Mono build gets Mono.Cecil; here it comes from NuGet. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <StartupObject>PortTools</StartupObject>
    <OutputPath>$(LinuxOut)/tools/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../tools/ApiScan.cs;../tools/PortScan.cs;../tools/PortPatch.cs;../tools/PortTools.cs" />
    <PackageReference Include="Mono.Cecil" Version="0.11.6" />
  </ItemGroup>
</Project>
